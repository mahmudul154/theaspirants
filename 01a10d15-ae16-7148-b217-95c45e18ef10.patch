+.gm-paper-progress{display:grid;gap:5px;font-size:.68rem;color:var(--ink2)}
+.gm-paper-progress b{font-family:var(--num);color:var(--ink)}
+.gm-bar{height:6px;border-radius:99px;background:var(--line);overflow:hidden}
+.gm-bar i{display:block;height:100%;border-radius:inherit;background:var(--green);transition:width .4s}
+.gm-bar.peer i{background:var(--accent)}
+.gm-result{display:grid;gap:14px}
+.gm-winner{border:1px solid var(--line);border-radius:16px;padding:18px 20px;text-align:center;font-weight:700;font-size:1.02rem}
+.gm-winner.win{border-color:color-mix(in srgb,var(--green) 45%,var(--line));background:color-mix(in srgb,var(--green) 9%,var(--card));color:var(--green)}
+.gm-winner.loss{border-color:color-mix(in srgb,var(--accent) 45%,var(--line));background:color-mix(in srgb,var(--accent) 8%,var(--card));color:var(--accent)}
+.gm-winner.draw{border-color:color-mix(in srgb,var(--amber) 45%,var(--line));background:color-mix(in srgb,var(--amber) 9%,var(--card));color:var(--amber)}
+.gm-winner.wait{color:var(--ink3)}
+.gm-result-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
+.gm-result-card{display:flex;flex-direction:column;gap:3px;border:1px solid var(--line);border-radius:16px;background:var(--card);padding:16px}
+.gm-result-card small{font-size:.64rem;letter-spacing:.12em;text-transform:uppercase;color:var(--ink3)}
+.gm-result-card b{font-family:var(--num);font-size:2rem;line-height:1.1}
+.gm-result-card span{color:var(--ink2);font-size:.74rem}
+.gm-result-card em{color:var(--ink3);font-size:.62rem;font-style:normal}
+.gm-result-card.you{border-color:color-mix(in srgb,var(--green) 34%,var(--line))}.gm-result-card.you b{color:var(--green)}
+.gm-result-card.peer{border-color:color-mix(in srgb,var(--accent) 30%,var(--line))}.gm-result-card.peer b{color:var(--accent)}
+.gm-compare{display:grid;gap:8px}
+.gm-compare-row{display:grid;gap:8px;border:1px solid var(--line);border-left:3px solid var(--line2);border-radius:12px;padding:11px 13px}
+.gm-compare-row.ok{border-left-color:var(--green)}
+.gm-compare-row.bad{border-left-color:var(--accent)}
+.gm-compare-row.skip{border-left-color:var(--amber)}
+.gm-compare-q{display:grid;gap:4px;font-size:.8rem;line-height:1.6}
+.gm-compare-q b{font-size:.66rem;letter-spacing:.08em;text-transform:uppercase;color:var(--ink3)}
+.gm-compare-q p{margin:0}
+.gm-compare-picks{display:grid;gap:4px;font-size:.72rem;color:var(--ink2)}
+.gm-compare-picks b{color:var(--ink)}
+.gm-compare-picks .ok b{color:var(--green)}
+.gm-compare-picks .bad b{color:var(--accent)}
+.gm-compare-picks .skip b{color:var(--amber)}
+.gm-compare-picks .correct b{color:var(--green)}
+.gm-reactions{position:fixed;right:16px;bottom:96px;z-index:70;display:flex;flex-direction:column;gap:6px}
+.gm-reactions button{width:42px;height:42px;border-radius:50%;border:1px solid var(--line);background:var(--card);font-size:1.15rem;cursor:pointer;box-shadow:0 10px 22px -18px rgb(17 17 17 / .6);transition:transform .16s}
+.gm-reactions button:hover{transform:translateY(-2px)}
+.gm-floats{position:fixed;left:16px;bottom:120px;z-index:70;display:grid;gap:8px;pointer-events:none}
+.gm-float{display:flex;align-items:center;gap:7px;border:1px solid var(--line);border-radius:99px;background:var(--card);padding:6px 12px;box-shadow:0 12px 26px -20px rgb(17 17 17 / .6);animation:gmFloat 2.6s ease forwards}
+.gm-float b{font-size:1.05rem}
+.gm-float small{font-size:.62rem;color:var(--ink3)}
+@keyframes gmFloat{0%{opacity:0;transform:translateY(10px)}14%{opacity:1;transform:translateY(0)}80%{opacity:1}100%{opacity:0;transform:translateY(-14px)}}
+@media(max-width:900px){
+  .gm-home-grid,.gm-seat-grid,.gm-result-grid{grid-template-columns:1fr}
+  .gm-paper-bar{grid-template-columns:auto minmax(0,1fr);row-gap:8px;top:64px}
+  .gm-paper-bar .btn{grid-column:2;justify-self:end}
+  .gm-seat{grid-template-columns:38px minmax(0,1fr) auto;padding:11px 12px}
+  .gm-avatar{width:38px;height:38px;font-size:.98rem}
+  .gm-room-code b{font-size:1.35rem;letter-spacing:.28em}
+  .gm-room-bar .gm-link{margin-left:0}
+  .gm-reactions{bottom:80px;right:12px}
+  .gm-reactions button{width:38px;height:38px;font-size:1rem}
+  .gm-floats{bottom:104px}
+}
+@media(max-width:560px){
+  .gm-countdown{padding:32px 16px}
+  .gm-qcard .qopt{flex-wrap:wrap}
+  .gm-tag{margin-left:auto}
+  .gm-compare-row{padding:10px}
+  .gm-result-card b{font-size:1.6rem}
+}
+/* Entry card for the 1v1 room on the custom-quiz page. */
+.game-mode-invite{border-color:color-mix(in srgb,#6a1b9a 30%,var(--line));background:color-mix(in srgb,#6a1b9a 5%,var(--card))}
+.game-mode-invite .hub-custom-icon{color:#6a1b9a;background:color-mix(in srgb,#6a1b9a 12%,var(--card))}
+.game-mode-invite:hover{border-color:#6a1b9a;background:color-mix(in srgb,#6a1b9a 9%,var(--card))}
+html.dark .game-mode-invite .hub-custom-icon{color:#ce93d8;background:color-mix(in srgb,#ce93d8 18%,var(--card))}
